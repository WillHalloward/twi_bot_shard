# =============================================================================
# Twi Bot Shard (Cognita) — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Full reference: docs/developer/environment-variables.md
# =============================================================================

# --- Core (required) ---------------------------------------------------------
# Discord bot token (Discord Developer Portal -> Bot -> Reset Token)
BOT_TOKEN=your_discord_bot_token
# Deployment environment: development | testing | staging | production
ENVIRONMENT=development

# --- Database (required: DATABASE_URL OR the individual vars below) ----------
# Railway/Heroku-style combined URL; takes precedence over individual vars
DATABASE_URL=postgresql://user:password@localhost:5432/cognita_db
# Individual variables (used when DATABASE_URL is unset; PGHOST/PGUSER/
# PGPASSWORD/PGDATABASE/PGPORT are also recognized)
HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DATABASE=your_database_name
PORT=5432
# SSL mode for database connections: disable | require | prefer
DB_SSL=disable

# --- Logging -----------------------------------------------------------------
# Base name for log files (default: test)
LOGFILE=dev
# Log output format: console | json | file
LOG_FORMAT=console
# Override the environment's default log level: DEBUG/INFO/WARNING/... or numeric (alias: LOGGING_LEVEL)
LOG_LEVEL=INFO

# --- Bot behavior ------------------------------------------------------------
# Seconds before the bot exits automatically; 0 disables (useful for testing)
KILL_AFTER=0
# Sync slash commands globally on startup: true | false (one-time deploy aid)
SYNC_ON_START=false

# --- Staging-specific --------------------------------------------------------
# Guild ID to restrict slash commands to in staging (faster command updates)
STAGING_GUILD_ID=123456789012345678
# Send webhook notifications: true | false (staging defaults to false if unset)
WEBHOOKS_ENABLED=true

# --- Observability (Sentry; read directly in utils/sentry_setup.py) ----------
# Project DSN from sentry.io; unset = Sentry is a complete no-op
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Performance-tracing sample rate, 0.0-1.0 (default 0.0 = off)
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Webhook logging (optional) ----------------------------------------------
# Discord webhook URL for development/testing logs
WEBHOOK_TESTING_LOG=https://discord.com/api/webhooks/...
# Discord webhook URL for production logs
WEBHOOK=https://discord.com/api/webhooks/...

# --- API integrations (optional; required for specific features) -------------
# Google Custom Search (both required if either is set)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_google_cse_id
# OpenAI (schema-search embeddings + owner-only ask_database command)
OPENAI_API_KEY=your_openai_api_key
# Twitter/X reposting (all 5 required if any is set)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_KEY_SECRET=your_twitter_api_key_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
# AO3 content fetching (both required if either is set)
AO3_USERNAME=your_ao3_username
AO3_PASSWORD=your_ao3_password

# --- Complex JSON structures (optional) ---------------------------------------
# HTTP cookies for external requests (used by Patreon poll scraping)
COOKIES={"patreon_device_id":"your_device_id"}
# HTTP headers for external requests
HEADERS={"User-Agent":"Mozilla/5.0"}
# Custom channel ID mappings (override hardcoded defaults)
CHANNEL_IDS={}
# Custom role ID mappings (override hardcoded defaults)
ROLE_IDS={}
