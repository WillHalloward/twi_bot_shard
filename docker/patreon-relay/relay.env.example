# Copy to relay.env (chmod 600). Never commit relay.env.
RELAY_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Railway Cognita static outbound IPs (prod .240, staging .241, shared 152.55.184.240/.241),
# Docker bridge gateway (requests from the NAS itself), home LAN:
ALLOW_IPS=208.77.244.240,208.77.244.241,152.55.184.240,152.55.184.241,172.29.16.1,192.168.0.0/24
# Session of the (non-creator) team account used for poll fetching:
PATREON_COOKIES={"patreon_device_id":"...","patreon_locale_code":"en-US","patreon_location_country_code":"SE","session_id":"..."}
PATREON_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:159.0) Gecko/20100101 Firefox/159.0
RATE_PER_MIN=30
